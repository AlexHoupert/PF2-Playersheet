{
  "name": "pf2-playersheet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "build:shop": "node scripts/build_shop.js",
    "build:spells": "node scripts/build_spells.js",
    "build:feats": "node scripts/build_feats.js",
    "build:actions": "node scripts/generate_action_index.js",
    "build:impulses": "node scripts/build_impulses.js",
    "build:creatures": "node scripts/build_creatures.js",
    "build:abilities": "node scripts/build_ability_index.js",
    "build:data": "npm run build:shop && npm run build:spells && npm run build:feats && npm run build:actions && npm run build:impulses && npm run build:creatures && npm run build:abilities",
    "build:app": "vite build",
    "build": "npm run build:data && vite build && node scripts/copy_ressources_to_dist.js",
    "lint": "eslint src/shared/rules src/shared/utils src/shared/hooks src/shared/db/domain src/player/views/StatsView.jsx src/player/sections src/shared/components/ActorSheetCard.jsx src/shared/components/ActorEffectsDrawer.jsx src/shared/components/ActorEffectsSection.jsx src/shared/components/ClosableEffectChip.jsx src/shared/components/ConditionList.jsx src/player/PlayerAppController.jsx src/admin/AdminTabContent.jsx tests --quiet",
    "check:broad-writes": "node scripts/check_broad_writes.js",
    "check": "npm test && npm run check:broad-writes && npm run lint && npm run build:app",
    "smoke": "playwright test",
    "smoke:install": "playwright install chromium",
    "migrate:v2:dry-run": "node scripts/migrate_master_to_v2.js --from-firestore --report-out recovery/v2-migration-report.json",
    "migrate:v2": "node scripts/migrate_master_to_v2.js --from-firestore --write --backup-file --report-out recovery/v2-migration-report.json",
    "cleanup:legacy-conditions": "node scripts/cleanup_legacy_condition_effects.js",
    "backfill:catalog-effects": "node scripts/backfill_catalog_effect_definitions.js",
    "migrate:lore:dry-run": "node scripts/migrate_lore_to_campaign.js",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@tailwindcss/vite": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "firebase": "^12.7.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "vite": "^5.0.0"
  }
}
